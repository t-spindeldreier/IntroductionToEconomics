{
  "name": "econ-live",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "emulators": "node scripts/emu.mjs emulators:start",
    "build": "tsc --noEmit && vite build && node scripts/size.mjs",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/emu.mjs emulators:exec --only firestore \"vitest run tests/rules\"",
    "simulate": "node scripts/emu.mjs emulators:exec --only firestore,auth \"tsx scripts/simulate.ts\"",
    "smoke": "node scripts/emu.mjs emulators:exec --only firestore,auth \"node scripts/smoke.mjs\"",
    "deploy:rules": "node scripts/emu.mjs deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "qrcode-generator": "^2.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.6",
    "firebase-tools": "^15.36.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
